---
import Link from "@/components/ui/Link.astro";
import Layout from "@/layouts/Layout.astro";
import { createTranslate } from "@/lib/i18n";

const table = {
  en: {
    title: "404 - Page Not Found",
    desc: "The page you were looking for does not exist.",
    link: "Home page",
  },
  pt: {
    title: "404 - Página Não Encontrada",
    desc: "A página que você estava procurando não existe.",
    link: "Página inicial",
  },
};
const t = createTranslate(Astro.currentLocale, table);
---

<Layout
  title={t("title")}
  desc={t("desc")}
  class="grid min-h-svh place-content-center gap-4 p-4"
>
  <h1 class="text-center font-heading text-4xl font-black">
    {t("title")}
  </h1>
  <p class="text-center text-xl">
    {t("desc")}
  </p>

  <Link
    href="/"
    class="rounded-full bg-foreground p-4 text-center text-xl font-black tracking-wider text-background uppercase"
    >{t("link")}</Link
  >
</Layout>
