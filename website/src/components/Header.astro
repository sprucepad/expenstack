---
import MenuIcon from "@lucide/astro/icons/menu";
import XIcon from "@lucide/astro/icons/x";
import Favicon from "@public/favicon.svg";
import Link from "@/components/ui/Link.astro";
import { createTranslate } from "@/lib/i18n";

const table = {
  en: {
    download: "Download",
    buymeacoffee: "Buy me a Coffee",
    changelog: "Changelog",
    privacyPolicy: "Privacy Policy",
  },
  pt: {
    download: "Download",
    buymeacoffee: "Me Compre um Café",
    changelog: "Mudanças",
    privacyPolicy: "Política de Privacidade",
  },
};
const t = createTranslate(Astro.currentLocale, table);
---

<header
  id="topnav"
  transition:persist="topnav"
  class="bg-foreground text-background fixed inset-4 flex h-16 items-center justify-between rounded-full p-4 transition-[opacity,visibility] data-hidden:invisible data-hidden:opacity-0"
>
  <Link href="/" class="flex items-center gap-4 text-2xl font-black">
    <Favicon width={48} height={48} />
    Expenstack
  </Link>

  <button class="peer group md:hidden">
    <MenuIcon class="group-data-open:hidden" />
    <XIcon class="hidden group-data-open:block" />
  </button>

  <nav
    class="bg-foreground fixed top-24 right-4 translate-x-[125%] transform rounded-lg p-4 transition-transform peer-data-open:translate-x-0 md:static md:translate-x-0 md:transform-none md:p-0"
  >
    <ul class="flex flex-col gap-4 md:flex-row">
      <li>
        <Link class="block text-end hover:underline" href="/download"
          >{t("download")}</Link
        >
      </li>
      <li>
        <Link
          class="block text-end hover:underline"
          href="https://www.buymeacoffee.com/sprucepad"
        >
          {t("buymeacoffee")}
        </Link>
      </li>
      <li>
        <Link class="block text-end hover:underline" href="/changelog">
          {t("changelog")}
        </Link>
      </li>
      <li>
        <Link class="block text-end hover:underline" href="/privacy-policy">
          {t("privacyPolicy")}
        </Link>
      </li>
    </ul>
  </nav>
</header>

<script>
  const $topNav = document.getElementById("topnav");
  const $button = $topNav?.querySelector("button");

  $button?.addEventListener("click", () =>
    $button.toggleAttribute("data-open"),
  );

  let previousScrollY = window.scrollY;
  window.addEventListener("scroll", () => {
    const diff = window.scrollY - previousScrollY;
    if (diff < 0) $topNav?.removeAttribute("data-hidden");
    if (diff > 0) $topNav?.setAttribute("data-hidden", "");

    previousScrollY = window.scrollY;
  });
</script>
