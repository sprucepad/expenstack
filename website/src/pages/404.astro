---
import Layout from "@/layouts/Layout.astro";
---

<Layout
  title="404 - Page Not Found"
  desc="The page you were looking for does not exist."
  class="grid min-h-svh place-content-center gap-4 p-4"
>
  <h1 class="font-heading text-center text-4xl font-black">
    404 - Page Not Found
  </h1>
  <p class="text-center text-xl">
    The page you were looking for does not exist.
  </p>

  <a
    href="/"
    class="bg-foreground text-background rounded-full p-4 text-center text-xl font-black tracking-wider uppercase"
    >Home page</a
  >
</Layout>
