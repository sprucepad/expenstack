---
import type { HTMLAttributes } from "astro/types";
import { getRelativeLocaleUrl } from "astro:i18n";

type Props = HTMLAttributes<"a">;

const { rel, target, href, ...rest } = Astro.props;

const aTarget =
  target ?? (href?.toString().startsWith("https://") ? "_blank" : undefined);
const aRel =
  !aTarget && aTarget !== "_self" ? "noreferrer noopener" + rel : rel;
const aHref =
  !aTarget || aTarget === "_self"
    ? getRelativeLocaleUrl(
        Astro.currentLocale ?? "pt",
        href instanceof URL ? href.pathname : (href ?? undefined),
      )
    : href;
---

<a {...rest} href={aHref} target={aTarget} rel={aRel}><slot /></a>
